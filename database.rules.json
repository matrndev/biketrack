{
  "rules": {
    ".read": false,
    ".write": false,

    "_debug": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "groups": {
      "$groupId": {
        ".read": "auth != null && data.child('members').child(auth.uid).exists()",
        ".write": "auth != null && !newData.exists() && data.child('meta').child('leaderId').val() === auth.uid",

        "meta": {
          ".write": "auth != null && (!data.exists() || data.child('leaderId').val() === auth.uid)",
          ".validate": "newData.hasChildren(['name', 'leaderId', 'createdAt', 'joinCode'])"
        },

        "members": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && (auth.uid === $uid || root.child('groups').child($groupId).child('meta').child('leaderId').val() === auth.uid)"
          }
        },

        "presence": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid"
          }
        },

        "comms": {
          "$commId": {
            ".write": "auth != null && root.child('groups').child($groupId).child('members').child(auth.uid).exists()",
            ".validate": "newData.hasChildren(['type', 'severity', 'lat', 'lng', 'dedupKey', 'createdBy', 'createdAt', 'expiresAt', 'count'])"
          }
        }
      }
    },

    "joinCodes": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() || !root.child('groups').child(data.val()).exists() || root.child('groups').child(data.val()).child('meta').child('leaderId').val() === auth.uid)",
        ".validate": "$code.matches(/^[0-9]{6}$/) && newData.isString()"
      }
    }
  }
}
